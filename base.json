{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "abandonments:recommended",
    ":configMigration",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":docker",
    ":enableVulnerabilityAlerts",
    ":separateMultipleMajorReleases",
    "docker:pinDigests",
    "group:recommended",
    "helpers:pinGitHubActionDigests",
    "security:openssf-scorecard",
    "workarounds:all",
    ":automergeRequireAllStatusChecks",
    "schedule:daily"
  ],
  "updateNotScheduled": false,
  "automergeType": "pr",
  "configMigration": true,
  "separateMultipleMajor": true,
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/|\\.)mise\\.toml$"
      ],
      "matchStrings": [
        "\"github:(?<packageName>[^\"]+)\"\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "@cloudflare/workers-types",
        "@cloudflare/workerd-linux-64",
        "wrangler"
      ],
      "automerge": true,
      "ignoreTests": true
    },
    // Group tool versions across Docker and mise.toml
    {
      "description": "Group Go updates from Docker",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "groupName": "Go version"
    },
    {
      "description": "Group Go updates from mise.toml",
      "matchDatasources": [
        "golang-version"
      ],
      "matchPackageNames": [
        "go"
      ],
      "groupName": "Go version"
    },
    {
      "description": "Group uv updates from Docker",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/astral-sh/uv"
      ],
      "groupName": "uv version"
    },
    {
      "description": "Group uv updates from mise.toml",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "uv"
      ],
      "groupName": "uv version"
    },
    {
      "description": "Group Bun updates from Docker",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "oven/bun"
      ],
      "groupName": "Bun version"
    },
    {
      "description": "Group Bun updates from mise.toml",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "bun"
      ],
      "groupName": "Bun version"
    },
    {
      "description": "Group Node.js updates from Docker",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "groupName": "Node.js version"
    },
    {
      "description": "Group Node.js updates from mise.toml",
      "matchDatasources": [
        "node-version"
      ],
      "matchPackageNames": [
        "node",
        "aqua:nodejs/node"
      ],
      "groupName": "Node.js version"
    },
    {
      "description": "Group Node.js updates with @types/node",
      "matchDatasources": ["npm"],
      "matchPackageNames": [
        "@types/node"
      ],
      "groupName": "Node.js version"
    },
    // Migrate node to aqua:nodejs/node in mise.toml
    {
      "description": "Migrate mise node to aqua:nodejs/node (uses official binary instead of building from source)",
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "node"
      ],
      "replacementName": "aqua:nodejs/node",
      "replacementVersion": "auto"
    },
    {
      "matchPackageNames": [
        "albumentations" // discontinued, the last version available there is good enough
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": "required_provider",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ]
}
